# COMMON variables shared by PASS0, PASS1 and PASS2, keyed by storage address.
# Format:  $addr  NAME  group  MEANING (period documentation text, standalone)
# Development file: the generator turns it into names, declarations and DOC/VARS text.
[names]
$17B0 NV   symtab  NUMBER OF VARIABLE HASH CHAINS IN THE SYMBOL TABLE (32)
$17B2 NK   symtab  NUMBER OF CONSTANT HASH CHAINS (32)
$17B4 NL   symtab  NUMBER OF LINE NUMBER HASH CHAINS (32)
$17B6 VB   symtab  FIRST VARIABLE CHAIN HEAD IN {SY}() (9; 1-4 HOLD FN AND LINE SYMBOLS, 5-8 TEMPORARIES)
$17B8 KB   symtab  FIRST CONSTANT CHAIN HEAD IN {SY}()
$17BA LB   symtab  FIRST LINE NUMBER CHAIN HEAD IN {SY}()
$17BC HT   symtab  LAST CHAIN HEAD IN {SY}(); ENTRIES ARE ALLOCATED ABOVE IT
$17BE MO   disk    DRIVE MOTOR-ON SWITCH FOR THE BOOT SLOT ($C089+SLOT*16), TOUCHED TO KEEP THE DRIVE SPINNING
$17C0 MF   disk    DRIVE MOTOR-OFF SWITCH FOR THE BOOT SLOT
$17C2 DM   disk    DOS STATE BYTE AT $AA52: POKED BEFORE EACH DIRECT FILE READ OR WRITE
$17C4 EC   disk    RUNTIME ROUTINE THAT CLEARS AN ONERR CONDITION (CALLED AFTER A HANDLED ERROR)
$17C6 LL   memory  LENGTH OF THE RUNTIME LIBRARY IN BYTES (4013)
$17C8 UP   page3   ADDRESS OF THE USR ROUTINE THAT PACKS A NUMBER INTO FIVE BYTES ($0377)
$17CA KP   page3   ADDRESS OF THE FIVE PACKED BYTES LEFT BY THE USR ROUTINE ($0371)
$17CC RB   page3   ADDRESS OF THE ROUTINE THAT READS ONE BYTE FROM THE OPEN FILE INTO {IO} ($037E)
$17CE WB   page3   ADDRESS OF THE ROUTINE THAT WRITES THE BYTE IN {IO} TO THE OPEN FILE ($0387)
$17D0 IO   page3   ADDRESS OF THE ONE-BYTE TRANSFER CELL FOR {RB} AND {WB} ($0376)
$17D2 LS   page3   ADDRESS OF THE ROUTINE THAT LISTS THE TOKENIZED LINE IN THE INPUT BUFFER ($038D)
$17D4 LA   memory  LIBRARY ADDRESS, STORED AS ADDRESS-32767
$17D6 PS   memory  PROGRAM START, STORED AS ADDRESS-32767; MOVED UP BY COMMON DECLARATIONS
$17D8 VA   memory  VARIABLES ADDRESS ASKED FOR, AS ADDRESS-32767, OR -32767 FOR END OF PROGRAM
$17DA PC   memory  ADDRESS OF THE NEXT OBJECT CODE BYTE, AS ADDRESS-32767
$17DC LC   compile NUMBER OF SOURCE LINES READ
$17DE CS   memory  START OF THE COMMON BLOCK (THE PROGRAM START BEFORE COMMON MOVED IT)
$17E0 DL   compile ADDRESS OF THE LINK WORD OF THE LAST DATA BLOCK (DATA BLOCKS ARE CHAINED)
$17E2 FB   memory  OBJECT FILE BASE: FILE POSITION = {PC} - {FB} (THE FILE STARTS WITH THE BSAVE HEADER)
$17E4 SD   disk    1 IF THE SOURCE AND OBJECT FILES ARE ON THE BOOT DRIVE (MOTOR KEPT ON), ELSE 0
$17E6 OL   option  COMPILATION LISTING OPTION (1 = YES)
$17E8 OP   option  PAUSE ON ERRORS OPTION (1 = YES)
$17EA OD   option  RESUME/DEBUG CODE OPTION (1 = YES)
$17EC OI   option  INTEGER ARITHMETIC OPTION (1 = YES)
$17EE OK   option  INTEGER CONSTANTS OPTION (1 = YES)
$17F0 FE   compile 1 ONCE A FATAL ERROR HAS BEEN REPORTED (NO MORE CODE IS WRITTEN)
$17F2 CM   compile COMMON KIND: -1 NONE, 0 DEFINE, 255 USE
$17F4 DP   disk    DOS PATCH TABLE: {DP}(I,0) ADDRESS (AS ADDRESS-32767), {DP}(I,1) ORIGINAL BYTE
$180C SY   symtab  SYMBOL TABLE: CHAIN HEADS, THEN ENTRIES LINKED THROUGH THEIR FIRST WORD
$41DA BE$  text    TWO BELLS, SOUNDED BEFORE EACH ERROR MESSAGE
$41DC D$   text    CONTROL-D, THE DOS COMMAND PREFIX
$41DE OP$  text    DOS OPEN COMMAND
$41E0 CL$  text    DOS CLOSE COMMAND
$41E2 RD$  text    DOS READ COMMAND
$41E4 WR$  text    DOS WRITE COMMAND
$41E6 SF$  text    SOURCE FILE NAME
$41E8 OF$  text    OBJECT FILE NAME
$41EA LN$  text    NAME OF THE LINE NUMBER FILE ("CLINENUM")
$41EC DD$  text    SLOT AND DRIVE OF THE BOOT DRIVE (",S6,D1")
$41EE SS$  text    SLOT AND DRIVE OF THE SOURCE FILE
$41F0 OS$  text    SLOT AND DRIVE OF THE OBJECT FILE
