# RUNTIME annotations (development file): the source tasc.rtsource writes as src/RUNTIME.S.
# [equates]   NAME $value COMMENT              names for addresses outside RUNTIME
# [labels]    $addr LABEL                      names inside RUNTIME (at most 8 characters)
# [routines]  $addr TEXT                       comment block above the address ("|" starts a new line)
# [lines]     $addr COMMENT                    comment at the end of the line at addr
# [data]      $first $last KIND COMMENT        bytes written as DFB (KIND: bytes, text, code)
[equates]
CHARAC $0D TEMPORARY
ENDCHR $0E TEMPORARY
NUMDIM $0F TEMPORARY: DIMENSION COUNT
DIMFLG $10 TEMPORARY
DATFIRST $12 HEADER: ADDRESS OF THE FIRST DATA ITEM (2 BYTES)
HIGHEST $14 HEADER: HIGHEST ADDRESS USED BY LIBRARY, PROGRAM OR VARIABLES (2)
HDRFLAG $16 HEADER: COMMON FLAG; ALSO A TEMPORARY
HGRSHAPE $1A HI-RES SHAPE POINTER (2)
CH $24 MONITOR: CURSOR COLUMN
H2 $2C MONITOR: RIGHT END OF A LO-RES LINE
V2 $2D MONITOR: BOTTOM END OF A LO-RES LINE
PROMPT $33 MONITOR: PROMPT CHARACTER
A1L $3C MONITOR: A1 (2)
LINNUM $50 ADDRESS TEMPORARY (2)
TEMPPT $52 TEMPORARY
TPTR $55 TEMPORARY POINTER (2)
FLTVEC $58 JMP TO THE ROUTINE THAT FLOATS THE INTEGER ACCUMULATOR (3)
ERRVEC $5B JMP TO THE CODE HANDLING ONERR (3)
RESULT $62 TEMPORARIES (5)
TXTTAB $67 APPLESOFT START OF PROGRAM (2)
COMBEG $69 START OF THE COMMON BLOCK - 1 (2)
NUMCEND $6B END OF NUMERIC COMMON (2)
STRCEND $6D END OF STRING COMMON (2)
FRETOP $6F BOTTOM OF STRINGS - 1 (2)
INPOS $71 INPUT BUFFER POSITION ($FF NEW LINE, $FE USED UP)
MEMSIZ $73 HIMEM (2)
CURLIN $75 ADDRESS OF THE OBJECT CODE BEING EXECUTED (2)
STRACC $77 STRING ACCUMULATOR: THE LOADED STRING (2)
STRPSH $79 THE PUSHED STRING (2)
LOCBEG $7B START OF LOCAL VARIABLES - 1 (2)
LOCNEND $7D END OF LOCAL NUMERIC VARIABLES (2)
LOCSEND $7F END OF LOCAL STRING VARIABLES (2)
VARNAM $81 TEMPORARY (2)
RETADR $83 TEMPORARY: A SAVED RETURN ADDRESS (2)
FORPNT $85 TEMPORARY POINTER (2)
TEMP3 $8A TEMPORARIES (5)
TEMP1 $93 TEMPORARIES; ALSO THE COLLECTOR'S POINTERS (5)
FAC $9D FLOATING POINT ACCUMULATOR (EXPONENT, 4 MANTISSA BYTES, SIGN AT $A2)
IARG $9E INTEGER ARGUMENT (HIGH, LOW)
IACC $A0 INTEGER ACCUMULATOR (HIGH, LOW)
FACSIGN $A2 SIGN OF FAC
SERLEN $A3 TEMPORARY
ARG $A5 SECOND FLOATING POINT ACCUMULATOR (5, SIGN AT $AA)
ARGSIGN $AA SIGN OF ARG
SGNCPR $AB TEMPORARY: SIGN COMPARISON, NEGATION COUNT
SERPNT $AD TEMPORARY (2)
FORPOP $AF ADDRESS OF THE ROUTINE THAT POPS FOR ENTRIES (2)
CHRGET $B1 APPLESOFT CHRGET (MODIFIED)
CHRGOT $B7 CHRGOT, INSIDE CHRGET
TXTPTR $B8 TEXT POINTER, INSIDE CHRGET (2)
CHRPAT $BA WHERE THE CHRGET PATCH GOES
ERRFLG $D8 $80 WHEN ONERR IS ACTIVE
ELTYPE $D9 TEMPORARY: ARRAY ELEMENT TYPE
ERRLIN $DA OBJECT ADDRESS OF THE STATEMENT THAT FAILED (2)
ERRPOS $DC TEMPORARY: ARRAY ELEMENT ADDRESS (2)
ERRSTK $DF STACK POINTER BEFORE THE FAILED STATEMENT
HGRSCALE $E7 HI-RES SCALE
SHAPETBL $E8 ADDRESS OF THE SHAPE TABLE (2)
FIRST $F0 TEMPORARY: LO-RES / SHAPE ARGUMENT
SPEEDZ $F1 OUTPUT SPEED
TRCFLG $F2 TRACE FLAG
TXTPSV $F4 ONERR TEXT POINTER (2)
DATPTR $F6 POINTER INTO THE DATA ITEMS (2)
REMSTK $F8 STACK POINTER BEFORE THE STATEMENT
HGRROT $F9 HI-RES ROTATION
ZPFF $FF LAST BYTE OF PAGE ZERO
STACK $0100 THE 6502 STACK
INBUF $0200 INPUT BUFFER
AMPER $03F5 AMPERSAND VECTOR (3)
ERROR $D412 ROM: REPORT ERROR X
INLIN $D52C ROM: READ A LINE INTO THE INPUT BUFFER
INCHR $D553 ROM: READ A KEY
RUNCLR $D566 ROM: RUN, AFTER CLEARING VARIABLES
SCRTCH $D64B ROM: NEW
STOPCC $D863 ROM: CONTROL-C BREAK
LET2 $DA65 ROM: STORE FAC IN AN INTEGER VARIABLE (ROUND, RANGE CHECK)
CRDO $DAFB ROM: PRINT A CARRIAGE RETURN
STROUT $DB3A ROM: PRINT A STRING AT (Y,A)
OUTSP $DB57 ROM: PRINT A SPACE
OUTQUES $DB5A ROM: PRINT A QUESTION MARK
OUTDO $DB5C ROM: PRINT THE CHARACTER IN A
REENTER $DB87 ROM: ?REENTER (INSIDE INPERR)
SGNEXIT $DE59 ROM: SAVE THE SIGN COMPARISON, RETURN THE FAC EXPONENT (SETS THE FLAGS)
INTVAR $DEE9 ROM: LOAD THE INTEGER AT (VPNT) INTO FAC
AYINT $E10C ROM: FAC TO A 16-BIT INTEGER IN FAC+3/FAC+4 ($A0/$A1)
GIVAYF $E2F2 ROM: FLOAT THE INTEGER (A HIGH, Y LOW) INTO FAC
CONINT2 $E6FE ROM: INSIDE CONINT: FAC+3/4 TO A BYTE IN X (0-255)
GETADR $E752 ROM: FAC TO A 16-BIT ADDRESS IN LINNUM
POKE2 $E77E ROM: INSIDE POKE: STORE X AT (LINNUM)
WAIT2 $E793 ROM: INSIDE WAIT
FSUB $E7A7 ROM: FAC = (Y,A) - FAC
FADD $E7BE ROM: FAC = (Y,A) + FAC
FADDT $E7C1 ROM: FAC = ARG + FAC
FMULT $E97F ROM: FAC = (Y,A) * FAC
FMULTT $E982 ROM: FAC = ARG * FAC
CONUPK $E9E3 ROM: LOAD ARG FROM (Y,A)
FDIV $EA66 ROM: FAC = (Y,A) / FAC
FDIVT $EA69 ROM: FAC = ARG / FAC
MOVFM $EAF9 ROM: LOAD FAC FROM (Y,A)
MOV1F $EB21 ROM: PACK FAC INTO TEMP1
MOVMF $EB2B ROM: STORE FAC, ROUNDED, AT (Y,X)
MOVFA $EB53 ROM: COPY ARG TO FAC
MOVAF $EB63 ROM: COPY FAC, ROUNDED, TO ARG
SIGN $EB82 ROM: SIGN OF FAC IN A
FLOAT $EB93 ROM: FLOAT THE SIGNED BYTE IN A
FCOMP $EBB2 ROM: COMPARE FAC WITH (Y,A): A = -1, 0 OR 1
FIN $EC4A ROM: CONVERT THE NUMBER AT TXTPTR INTO FAC
INPRT $ED19 ROM: PRINT " IN " AND THE LINE NUMBER
PRNTFAC $ED2E ROM: PRINT FAC
FOUT $ED34 ROM: CONVERT FAC TO A STRING AT $0100
NEGOP $EED0 ROM: FAC = -FAC
CHRGIMG $F10B ROM: THE COPY OF CHRGET THAT INITIALIZES $B1-$C8
CHRCONT $F114 ROM: THE REST OF CHRGET AFTER THE SPACE CHECK
CALLROM $F1D8 ROM: INSIDE CALL: JSR (LINNUM)
INSLOT $F1E1 ROM: INSIDE IN#
PRSLOT $F1E8 ROM: INSIDE PR#
LINCHK $F1FD ROM: LO-RES COORDINATE CHECK
PLOTCHK $F220 ROM: LO-RES COORDINATE CHECK (BELOW 48)
PLOT2 $F228 ROM: INSIDE PLOT
HLIN2 $F235 ROM: INSIDE HLIN
VLIN2 $F244 ROM: INSIDE VLIN
COLOR2 $F252 ROM: INSIDE COLOR=
VTAB2 $F259 ROM: INSIDE VTAB
SPEED2 $F265 ROM: INSIDE SPEED=
HPOSN $F411 ROM: POSITION THE HI-RES CURSOR
HPLOT0 $F457 ROM: PLOT A HI-RES POINT
HGLIN $F53A ROM: DRAW A HI-RES LINE
DRAW1 $F605 ROM: DRAW A SHAPE
XDRAW1 $F661 ROM: XDRAW A SHAPE
HCOLOR2 $F6EC ROM: INSIDE HCOLOR=
HTAB2 $F7EA ROM: INSIDE HTAB
MONSCRN $F871 ROM: MONITOR SCRN
PREAD $FB1E ROM: READ A PADDLE
CROUT1 $FD8B ROM: CLEAR TO END OF LINE, CARRIAGE RETURN
