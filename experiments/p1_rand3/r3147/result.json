 "source": "10 REM! USECOMMON C$,Y%,X\n20 A$=A$\n30 PRINT PEEK(Y%);MID$(LEFT$(MID$(A$(M%,Y%),Z%),N2% AND N2%),-((NOT C)),LEN(A$(M%,100)));:A$=MID$(M$,.001*M<>((Z% AND 219)),5)\n40 XY=Z%:M$=MID$(RIGHT$(C$,1.5>=1),X):M=-Z%\n50 PRINT Z%>=LEN(MID$(M$,39,C));:INVERSE\n60 FOR XY=(N2) TO (X):GOSUB 150\n70 HPLOT ((M=Y%))-((Z%-Y%))<=((183>M>=((N2<X)))),(((100+XY))) TO -LOG(N2%)>=((C<>32767)),(SIN(N2%))\n80 POKE ((Y%)),((N2%<M%))/N2%\n90 A$(Y%,N2%>=VAL(\"\"))=A$(32767,Y%)+CHR$(N2%)+CHR$(M OR C)\n100 PRINT 40,VAL(\"HI\");((25432-ASC(A$(Y%,1))))*((((M<>N2%))-1)),:HCOLOR=XY:IF (-((M>M<X))) THEN 140\n110 READ Y%,M$:X=Z% AND N2%:PRINT\n120 M$=A$(34884>=N2^49152,ATN(M%)>(10)):CALL Y%:PRINT 127,\n130 C=NOT ((X<=1000))<>3:A$(1E3,Y%)=LEFT$(STR$(Z%-Y%),M*((M%*N2%))):A$=LEFT$(A$,X+-593)\n140 NEXT XY:IF (M) THEN M=SGN(3439):C=NOT ((N2%<>(Y%)))\n150 ON -((-((-39)))) GOTO 30,160:IF (XY) THEN Z%=894-RND(TAN(Z%))\n160 GET N2\n170 GOTO 160:A$(Z%,-3537)=C$\n",
